<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SweepV.Core\SweepV.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- The executable is SweepV.exe; namespaces stay SweepV.App. -->
    <AssemblyName>SweepV</AssemblyName>
    <RootNamespace>SweepV.App</RootNamespace>
    <Product>SweepV</Product>
    <Description>Free disk cleanup for Windows</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- App icon: embedded in SweepV.exe (Explorer, taskbar) and used by the window title bar. -->
  <PropertyGroup>
    <ApplicationIcon>Assets\SweepV.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\SweepV.ico" />
  </ItemGroup>

</Project>

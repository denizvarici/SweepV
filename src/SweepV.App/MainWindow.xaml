<Window x:Class="SweepV.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SweepV.App.Converters"
        Title="SweepV — Disk Cleanup" Height="760" Width="1240" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">
    <Window.Resources>
        <conv:BytesToTextConverter x:Key="Bytes"/>
        <conv:BoolToVisibilityConverter x:Key="Visible"/>
        <conv:BoolToVisibilityConverter x:Key="Hidden" Invert="True"/>

        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
        <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Resources>

    <TabControl Margin="10" Padding="0" BorderThickness="0" Background="Transparent">

        <!-- ================= QUICK CLEAN ================= -->
        <TabItem Header="  Quick Clean  " DataContext="{Binding Cleanup}">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Known safe cleanup locations" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Recommended items are pre-selected. Only the contents of checked locations are removed; files in use are skipped. Items marked with ⚠ may contain things you want to keep."/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <ListView ItemsSource="{Binding Items}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠ " Foreground="#D97706" FontWeight="Bold"
                                                       Visibility="{Binding IsCaution, Converter={StaticResource Visible}}"/>
                                            <TextBlock Text="{Binding Target.Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <Border Background="#EEF2FF" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                                    Visibility="{Binding Target.RequiresAdmin, Converter={StaticResource Visible}}">
                                                <TextBlock Text="admin" FontSize="11" Foreground="#4338CA"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Target.Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#059669" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="Analyze" Command="{Binding AnalyzeCommand}"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Margin="8,0" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    <Button DockPanel.Dock="Right" Content="Clean selected" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CleanCommand}" Margin="0"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="Selected:" Foreground="{StaticResource Muted}"/>
                        <Run Text="{Binding SelectedTotalText, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ================= EXPLORER ================= -->
        <TabItem Header="  Disk Explorer  ">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="380" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <!-- Left: scan + list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Scan:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelScanCommand}" Margin="0"
                                Visibility="{Binding IsScanning, Converter={StaticResource Visible}}"/>
                        <Button DockPanel.Dock="Right" Content="Scan" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScanCommand}"/>
                        <ComboBox ItemsSource="{Binding Drives}" Text="{Binding PathToScan, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Margin="0,0,6,0" Padding="4"/>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="← Back" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}"/>
                        <Button Content="↑ Up" Command="{Binding GoUpCommand}"/>
                        <TextBlock Text="{Binding CurrentNode.FullPath}" VerticalAlignment="Center" Margin="4,0,0,0"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <ListView x:Name="ExplorerList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedNode}"
                                  BorderThickness="0" SelectionMode="Single">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Ask AI: what is this?" Command="{Binding AskAiCommand}"/>
                                    <MenuItem Header="Open in File Explorer" Command="{Binding OpenInExplorerCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Move to Recycle Bin" Command="{Binding RecycleSelectedCommand}"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding RecycleSelectedCommand}"/>
                            </ListView.InputBindings>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="300">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📁 " Visibility="{Binding IsDirectory, Converter={StaticResource Visible}}"/>
                                                    <TextBlock Text="📄 " Visibility="{Binding IsDirectory, Converter={StaticResource Hidden}}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Size" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeInBytes, Converter={StaticResource Bytes}}"
                                                           HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="% of parent" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="110">
                                                    <ProgressBar Value="{Binding PercentOfParent, Mode=OneWay}" Maximum="100" Height="14"
                                                                 Foreground="#60A5FA" Background="#EFF6FF" BorderThickness="0"/>
                                                    <TextBlock Text="{Binding PercentOfParent, StringFormat={}{0:F1}%}" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Files" Width="80" DisplayMemberBinding="{Binding FileCount, StringFormat=N0}"/>
                                    <GridViewColumn Header="Modified" Width="95" DisplayMemberBinding="{Binding LastModifiedUtc, StringFormat=yyyy-MM-dd}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="🤖 Ask AI" Command="{Binding AskAiCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Open in Explorer" Command="{Binding OpenInExplorerCommand}"/>
                        <Button Content="🗑 Recycle" Command="{Binding RecycleSelectedCommand}"/>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- Right: AI chat -->
                <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding Chat}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button DockPanel.Dock="Right" Content="API key" Command="{Binding ToggleKeyEditorCommand}" Margin="0" MinWidth="0"/>
                            <TextBlock Text="🤖 AI folder advisor" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <StackPanel Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding IsKeyEditorOpen, Converter={StaticResource Visible}}">
                            <TextBlock Text="Gemini API key (stored encrypted for your Windows user):" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveApiKeyCommand}" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="3"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                                      ToolTip="Gemini model" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Efforts}" SelectedItem="{Binding SelectedEffort}"
                                      ToolTip="Thinking effort" MinWidth="90"/>
                        </Grid>

                        <TextBlock Margin="0,8,0,8" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11">
                            <Run Text="Subject:"/>
                            <Run Text="{Binding SubjectPath, Mode=OneWay, TargetNullValue='select an item and press Ask AI'}" FontFamily="Consolas"/>
                            <LineBreak/>
                            <Run Text="Only names, paths and sizes are sent — never file contents."/>
                        </TextBlock>
                        </StackPanel>

                        <ScrollViewer x:Name="ChatScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Bubble" CornerRadius="8" Padding="10,7" Margin="0,0,24,8"
                                                    Background="#F3F4F6" HorizontalAlignment="Left">
                                                <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True"
                                                         BorderThickness="0" Background="Transparent"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter TargetName="Bubble" Property="Background" Value="#DBEAFE"/>
                                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="Bubble" Property="Margin" Value="24,0,0,8"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Thinking…" Foreground="{StaticResource Muted}" FontStyle="Italic"
                                           Visibility="{Binding IsThinking, Converter={StaticResource Visible}}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <DockPanel Grid.Row="4" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" Margin="6,0,0,0"
                                    Style="{StaticResource PrimaryButton}" IsDefault="False"/>
                            <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                                     TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
